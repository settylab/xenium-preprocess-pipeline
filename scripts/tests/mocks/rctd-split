#!/usr/bin/env bash
# Mock rctd-split CLI — creates step-4 target artifacts and merges step4
# key into config.yaml (preserving step1: + step3: siblings).
set -euo pipefail

cmd="${1:-}"
if [[ "$cmd" != "run" ]]; then
    echo "mock rctd-split: only 'run' subcommand supported" >&2
    exit 2
fi
shift

sample=""
output_root=""
run_id=""
config_path=""
umi_min=""
counts_min=""
cell_min_instance=""
doublet_mode=""
postprocess_min_counts=""
keep_intermediate=0
force_rerun=0
max_cores=""

raw_argv=("$@")

while [[ $# -gt 0 ]]; do
    case "$1" in
        --sample-id)                 sample="$2"; shift 2 ;;
        --output-root)               output_root="$2"; shift 2 ;;
        --run-id)                    run_id="$2"; shift 2 ;;
        --config)                    config_path="$2"; shift 2 ;;
        --umi-min)                   umi_min="$2"; shift 2 ;;
        --counts-min)                counts_min="$2"; shift 2 ;;
        --cell-min-instance)         cell_min_instance="$2"; shift 2 ;;
        --doublet-mode)              doublet_mode="$2"; shift 2 ;;
        --postprocess-min-counts)    postprocess_min_counts="$2"; shift 2 ;;
        --keep-intermediate)         keep_intermediate=1; shift ;;
        --force-rerun)               force_rerun=1; shift ;;
        --max-cores)                 max_cores="$2"; shift 2 ;;
        *) shift ;;
    esac
done

: "${sample:?--sample-id required}"
: "${output_root:?--output-root required}"
: "${run_id:?--run-id required}"

run_dir="$output_root/$sample/${sample}_${run_id}"

# Step 4 depends on step 3's reference.rds landing.
if [[ ! -f "$run_dir/rctd/${sample}_reference.rds" ]]; then
    echo "mock rctd-split: reference.rds missing — step 3 missed? $run_dir" >&2
    exit 3
fi

mkdir -p "$run_dir/rctd" "$run_dir/spatial_adata" "$run_dir/logs"

: > "$run_dir/rctd/${sample}_rctd_results.rds"
: > "$run_dir/spatial_adata/${sample}_proseg_purified.h5ad"
# celltype_writeback + writeback_to_step1_raw simulated: augment (touch)
# the two step-1 outputs in place.
touch "$run_dir/spatial_adata/${sample}_proseg_raw.h5ad"
touch "$run_dir/spatial_adata/${sample}_xenium_ranger.h5ad"

{
    echo "step4 ok"
    echo "umi_min=$umi_min"
    echo "counts_min=$counts_min"
    echo "cell_min_instance=$cell_min_instance"
    echo "doublet_mode=$doublet_mode"
    echo "postprocess_min_counts=$postprocess_min_counts"
    echo "keep_intermediate=$keep_intermediate"
    echo "force_rerun=$force_rerun"
    echo "max_cores=$max_cores"
    echo "config_path=$config_path"
    if [[ -n "$config_path" && -f "$config_path" ]]; then
        echo "--- config yaml ---"
        cat "$config_path"
        echo "--- end config ---"
    fi
    echo "raw_argv=${raw_argv[*]}"
} > "$run_dir/logs/rctd-split.log"

cfg="$run_dir/config.yaml"
python3 - "$cfg" "$sample" "$run_id" <<'PY'
import sys, os
cfg_path, sample, run_id = sys.argv[1], sys.argv[2], sys.argv[3]
lines = []
if os.path.exists(cfg_path):
    with open(cfg_path) as f:
        lines = f.readlines()

out = []
skip = False
for line in lines:
    if skip:
        if line and not line[0].isspace() and line.strip() != "":
            skip = False
        else:
            continue
    if line.startswith("step4:"):
        skip = True
        continue
    out.append(line)
out.append(f"step4:\n  sample_id: {sample}\n  run_id: {run_id}\n")

with open(cfg_path, "w") as f:
    f.writelines(out)
PY
