#!/usr/bin/env bash
# Mock xenium-preprocess CLI — creates the xenium-preprocess target
# artifacts and writes the xenium_preprocess key into config.yaml. Only
# understands the subset of flags submit_xenium-preprocess.sbatch invokes.
set -euo pipefail

cmd="${1:-}"
if [[ "$cmd" != "run" ]]; then
    echo "mock xenium-preprocess: only 'run' subcommand supported" >&2
    exit 2
fi
shift

sample=""
output_root=""
run_id=""
config_path=""
x_source=""
qc_min_counts_cell=""
gex_only=""
force_rerun=0

# Capture the raw argv so tests can assert on the flags xenium-preprocess
# receives (in particular for per-stage overrides threaded from the driver).
raw_argv=("$@")

while [[ $# -gt 0 ]]; do
    case "$1" in
        --sample-id)              sample="$2"; shift 2 ;;
        --output-root)            output_root="$2"; shift 2 ;;
        --run-id)                 run_id="$2"; shift 2 ;;
        --config)                 config_path="$2"; shift 2 ;;
        --x-source)               x_source="$2"; shift 2 ;;
        --qc-min-counts-cell)     qc_min_counts_cell="$2"; shift 2 ;;
        --gex-only)               gex_only="$2"; shift 2 ;;
        --force-rerun)            force_rerun=1; shift ;;
        --proseg-dir|--xenium-cells|--xenium-ranger-dir) shift 2 ;;
        *) shift ;;
    esac
done

: "${sample:?--sample-id required}"
: "${output_root:?--output-root required}"
: "${run_id:?--run-id required}"

run_dir="$output_root/$sample/${sample}_${run_id}"
mkdir -p "$run_dir/spatial_adata" "$run_dir/rctd" "$run_dir/logs"

: > "$run_dir/spatial_adata/${sample}_proseg_raw.h5ad"
: > "$run_dir/spatial_adata/${sample}_xenium_ranger.h5ad"
: > "$run_dir/rctd/${sample}_test_object.rds"
{
    echo "xenium-preprocess ok"
    echo "x_source=$x_source"
    echo "qc_min_counts_cell=$qc_min_counts_cell"
    echo "gex_only=$gex_only"
    echo "force_rerun=$force_rerun"
    echo "config_path=$config_path"
    if [[ -n "$config_path" && -f "$config_path" ]]; then
        echo "--- config yaml ---"
        cat "$config_path"
        echo "--- end config ---"
    fi
    echo "raw_argv=${raw_argv[*]}"
} > "$run_dir/logs/xenium-preprocess.log"

# Merge xenium_preprocess key into config.yaml (crude but preserves siblings).
cfg="$run_dir/config.yaml"
python3 - "$cfg" "$sample" "$run_id" <<'PY'
import sys, os
cfg_path, sample, run_id = sys.argv[1], sys.argv[2], sys.argv[3]
lines = []
if os.path.exists(cfg_path):
    with open(cfg_path) as f:
        lines = f.readlines()

# Simple in-place "replace or append the xenium_preprocess: block".
out = []
skip = False
for line in lines:
    if skip:
        if line and not line[0].isspace() and line.strip() != "":
            skip = False
        else:
            continue
    if line.startswith("xenium_preprocess:"):
        skip = True
        continue
    out.append(line)
out.append(f"xenium_preprocess:\n  sample_id: {sample}\n  run_id: {run_id}\n")

with open(cfg_path, "w") as f:
    f.writelines(out)
PY
